# Copy this file to .env and adjust values for your machine.
APP_NAME=NEXPLY API
APP_MODULE=nexus.api.main:app
APP_DIR=src
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=DEBUG

# PostgreSQL identity database; use the nexply_app role, never a superuser.
DATABASE_URL=postgresql://nexply_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/nexply
JWT_SECRET_KEY=
JWT_ISSUER=nexply-api
JWT_AUDIENCE=nexply-web
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password recovery email (SMTP). Use an app password if your provider requires it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=deepakgs135@gmail.com
SMTP_PASSWORD=kjtc vghq enmi udwr
SMTP_FROM_EMAIL=deepakgs135@gmail.com
SMTP_USE_TLS=true
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=nexply
MONGODB_RESUME_COLLECTION=resume
MONGODB_JD_COLLECTION=jd
MONGODB_GRIDFS_BUCKET=document_files
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

MAX_UPLOAD_SIZE_MB=15

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_MODEL=qwen3.5:9b
# Separate model for the optional AI Smart resume rewrite/export flow.
OLLAMA_RESUME_WRITER_MODEL=llama3.1:8b
OLLAMA_RESUME_WRITER_NUM_PREDICT=6144
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=4096
